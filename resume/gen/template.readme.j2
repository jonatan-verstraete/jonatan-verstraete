- {{ bullet }}
{% endfor %}
{%- if not loop.last %}
<br/>
{% endif %}
{% endfor %}

---
### Projects
<table width="100%">
{%- for project in projects -%}
{%- if loop.index0 % 2 == 0 %}<tr>{% endif %}
<td width="50%" valign="top">
{%- if project.link %}
  <a href="{{ project.link }}"><b>{{ project.name }}</b></a>
{%- else %}
  <b>{{ project.name }}</b>
{% endif %}

<p style="font-size: 0.85em; margin-top: 4px;">{{ project.description }}</p>
</td>
{%- if loop.index0 % 2 == 1 or loop.last %}</tr>{% endif %}
{%- endfor %}
</table>

### Tech Stack  <img src="./assets/clippy.gif" width="20px" />

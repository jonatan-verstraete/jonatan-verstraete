<h1 align="center">{{ firstname }} <img src="https://media.giphy.com/media/hvRJCLFzcasrR4ia7z/giphy.gif" width="25"></h1>

<div align="center">

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="./assets/loop-dark.gif" type="image/gif"/>
  <source media="(prefers-color-scheme: light)" srcset="./assets/loop-light.gif" type="image/gif"/>
  <img alt="Focus" src="./assets/loop-light.gif"/>
</picture>

</div>
{% if bio %}
<p align="center"><i>{{ bio }}</i></p>
{% endif %}
<p align="center">
  <a href="https://jayf0x.github.io/#/contact"><b>jayf0x.github.io</b></a>
</p>

---

<h3 align="center">🚀 Projects</h3>

<p align="center"><sub>top {{ projects|length }} selection by <code>{{ model }}</code> · <a href="{{ projects_file_url }}">ℹ️ how it's picked</a></sub></p>

<table align="center">
{% for row in projects|batch(3) %}
<tr>
{% for project in row %}
<td align="center" width="320" valign="top">
  <a href="{{ project.link }}" title="{{ project.description }}">
    <img src="{{ project.preview_url }}" width="300" alt="{{ project.name }}"/>
    <br/><b>{{ project.name }}</b>
  </a>
  {% if project.description %}<br/><sub>{{ project.description }}</sub>{% endif %}
</td>
{% endfor %}
</tr>
{% endfor %}
</table>

---
{% if npm_packages %}
<h3 align="center">📦 npm</h3>

{% for pkg in npm_packages %}
- **[{{ pkg.name }}](https://www.npmjs.com/package/{{ pkg.name }})** &nbsp;<img src="https://img.shields.io/npm/dm/{{ pkg.name }}?style=flat-square&color=E8612C&logo=npm&logoColor=white&label=" alt="{{ pkg.name }} weekly downloads" valign="middle"/>
{% endfor %}

<p align="center"><sub><a href="https://jayf0x.github.io/#/127-0-0-1?tag=npm">view all →</a></sub></p>


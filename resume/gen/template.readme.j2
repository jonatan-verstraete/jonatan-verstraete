---
{% if npm_packages %}
<h3 align="center">📦 npm</h3>

<p align="center">
{% for pkg in npm_packages -%}
<a href="https://www.npmjs.com/package/{{ pkg.name }}"><img src="https://img.shields.io/npm/dm/{{ pkg.name }}?style=flat-square&color=E8612C&logo=npm&logoColor=white&label={{ pkg.name }}" alt="{{ pkg.name }} downloads"/></a>
{% endfor -%}
</p>

<p align="center"><sub><a href="https://jayf0x.github.io/#/127-0-0-1?tag=npm">view all →</a></sub></p>
{% endif %}
{% if projects %}
<h3 align="center">🚀 Projects</h3>

<p align="center"><sub>top {{ projects|length }} selection by <code>{{ model }}</code> · <a href="{{ projects_file_url }}">ℹ️ how it's picked</a></sub></p>

{% for project in projects %}
<p align="center">
  <a href="{{ project.link }}" title="{{ project.description }}">
    <picture>
      <source srcset="{{ project.preview_url }}"/>
      <img src="/assets/placeholder.gif" width="520" alt="{{ project.name }} — {{ project.description }}"/>
    </picture>
  </a>
  {% if project.description %}<br/><sub>{{ project.description }}</sub>{% endif %}
</p>
{% endfor %}
{% endif %}
